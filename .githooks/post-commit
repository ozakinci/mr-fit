#!/usr/bin/env bash
# Opt-in: NOT active by default. This repo's default git hooks path is the
# normal .git/hooks, which does not run this file. Enable it with:
#
#   git config core.hooksPath .githooks
#
# Disable it again with:
#
#   git config --unset core.hooksPath
#
# What it does: runs the `code-reviewer` subagent (.claude/agents/code-reviewer.md,
# Opus) against the commit that was just made, and writes its findings to
# .review/<short-sha>.md. Runs in `post-commit`, so it never blocks or can
# fail the commit itself — it only runs after the commit already succeeded.
#
# Before enabling: this calls the `claude` CLI non-interactively and costs
# real API usage on every single commit, including WIP/fixup commits. Most
# people are better served invoking the code-reviewer agent on demand
# ("use the code-reviewer agent on the last commit") than auto-running it
# on every commit. Only enable this if you specifically want that.

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  exit 0
fi

SHA="$(git rev-parse --short HEAD)"
OUT_DIR=".review"
mkdir -p "$OUT_DIR"
OUT_FILE="$OUT_DIR/$SHA.md"

echo "code-reviewer (opus): reviewing commit $SHA in the background -> $OUT_FILE"

nohup claude -p \
  "Use the code-reviewer subagent to review commit $SHA. Output only its findings." \
  --agent code-reviewer \
  > "$OUT_FILE" 2>&1 &

disown 2>/dev/null || true
