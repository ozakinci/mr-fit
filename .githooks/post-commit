#!/usr/bin/env bash
# Enabled for this repo (core.hooksPath=.githooks — see AGENTS.md).
# Disable entirely with: git config --unset core.hooksPath
#
# After every commit, in the background, non-blocking, never fails or
# undoes the commit (post-commit can't block anyway — the commit already
# happened by the time this runs):
#
#   1. code-reviewer (opus) reviews the commit -> .review/<sha>.md
#   2. tester drafts/updates external Playwright coverage for the commit's
#      intent, in ../mr-fit-tester — left UNCOMMITTED there for human
#      review; this hook never runs `git commit` in the tester repo.
#
# Both cost real API usage per commit. Skip either one for a single commit
# with an env var, e.g.:
#   MRFIT_SKIP_REVIEW_HOOK=1 git commit -m "..."
#   MRFIT_SKIP_TESTER_HOOK=1 git commit -m "..."

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  exit 0
fi

SHA="$(git rev-parse --short HEAD)"
OUT_DIR=".review"
mkdir -p "$OUT_DIR"

# --- code-reviewer (opus): independent review of the commit ----------------
if [ -z "${MRFIT_SKIP_REVIEW_HOOK:-}" ]; then
  REVIEW_FILE="$OUT_DIR/$SHA.md"
  echo "code-reviewer (opus): reviewing commit $SHA in the background -> $REVIEW_FILE"
  nohup claude -p \
    "Use the code-reviewer subagent to review commit $SHA (git show $SHA). It should also apply its 'Working with commits' checklist: cross-reference the ticket ID in the commit message against project/tickets.md to judge whether the diff matches that ticket's stated scope, flag any gold-plating/irrelevant changes, and check test coverage. Output only its findings." \
    --agent code-reviewer \
    > "$REVIEW_FILE" 2>&1 &
  disown 2>/dev/null || true
fi

# --- tester: draft external black-box coverage for the commit's intent -----
if [ -z "${MRFIT_SKIP_TESTER_HOOK:-}" ]; then
  TEST_LOG_FILE="$OUT_DIR/$SHA-tests.md"
  echo "tester: drafting external test coverage for commit $SHA in the background -> ../mr-fit-tester (log: $TEST_LOG_FILE)"
  nohup claude -p \
    "A new commit ($SHA) just landed in the main Mr. Fit repo. Use the tester subagent: identify the commit's intent from its ticket ID (cross-referenced against project/tickets.md) and its commit message — not by reading the main repo's implementation, per your black-box rule. Then write or update Playwright tests in ../mr-fit-tester covering that intent. Do not run 'git commit' in the tester project; leave your changes uncommitted for human review. Summarize what you added or changed as your entire response." \
    --agent tester \
    > "$TEST_LOG_FILE" 2>&1 &
  disown 2>/dev/null || true
fi
